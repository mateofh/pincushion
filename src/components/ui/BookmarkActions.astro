---
// Acciones de un enlace: favorito (formulario POST con valor explícito) y editar.
// Uso: <BookmarkActions id={b.id} title={b.title} isFavorite={b.isFavorite} csrf={csrf} volver="/?vista=lista" />
import Icon from './Icon.astro';

interface Props {
  id: number;
  title: string;
  isFavorite: boolean;
  csrf: string;
  /** Ruta a la que volver tras la acción (PRG). */
  volver: string;
}
const { id, title, isFavorite, csrf, volver } = Astro.props;
const favLabel = isFavorite ? 'Quitar de favoritos' : 'Marcar como favorito';
// Mejora HTMX: la acción devuelve la página de `volver` (tras el 303) y se sustituye solo este enlace + el aviso.
const htmx = {
  'hx-target': 'closest article',
  'hx-select': `article[data-bookmark-id="${id}"]`,
  'hx-select-oob': '#flash',
  'hx-swap': 'outerHTML',
  'hx-sync': 'closest article:drop',
};
---

<div class="acts">
  <form method="post" action={`/enlaces/${id}/favorito`} hx-post={`/enlaces/${id}/favorito`} {...htmx}>
    <input type="hidden" name="_csrf" value={csrf} />
    <input type="hidden" name="volver" value={volver} />
    <input type="hidden" name="value" value={isFavorite ? '0' : '1'} />
    <button class="act fav" type="submit" aria-pressed={isFavorite ? 'true' : 'false'} title={favLabel}>
      <Icon name={isFavorite ? 'star-filled' : 'star'} />
      <span class="visually-hidden">{favLabel}</span>
    </button>
  </form>
  <form method="post" action={`/enlaces/${id}/papelera`} hx-post={`/enlaces/${id}/papelera`} {...htmx}>
    <input type="hidden" name="_csrf" value={csrf} />
    <input type="hidden" name="volver" value={volver} />
    <button class="act trash" type="submit" title="Mover a la papelera">
      <Icon name="trash" />
      <span class="visually-hidden">Mover «{title}» a la papelera</span>
    </button>
  </form>
  <a class="act" href={`/enlaces/${id}`} title="Editar" aria-label={`Editar «${title}»`}>
    <Icon name="edit" />
  </a>
</div>

<style>
  .acts {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  form {
    margin: 0;
  }
  .act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--r-pill);
    border: 0;
    background: transparent;
    color: var(--mf-graphite-3);
    cursor: pointer;
    text-decoration: none;
  }
  .act:hover {
    background: var(--border);
    color: var(--text);
  }
  .trash:hover {
    background: var(--mf-warn-text);
    color: #fff;
  }
  .fav[aria-pressed='true'] {
    color: var(--mf-gold-text);
  }
</style>
