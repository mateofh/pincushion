---
// Disposición de la Biblioteca: barra lateral (slot "sidebar") + contenido. En < 720 px la
// barra lateral desaparece (la sustituye <MobileFilters>, que va dentro del contenido).
// Uso: <LibraryShell><Sidebar slot="sidebar" … /> <MobileFilters … /> … </LibraryShell>
---

<div class="shell">
  <aside class="side"><slot name="sidebar" /></aside>
  <div class="content"><slot /></div>
</div>

<style>
  .shell {
    display: grid;
    gap: var(--s-5);
    grid-template-columns: minmax(0, 1fr);
  }
  .side {
    display: none;
  }
  .content {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    align-content: start;
  }
  @media (min-width: 721px) {
    .shell {
      grid-template-columns: 248px minmax(0, 1fr);
      align-items: start;
    }
    .side {
      display: block;
    }
  }
</style>
