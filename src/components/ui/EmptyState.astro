---
// Estado vacío: título, texto y acciones (slot "actions"). `grid` activa la retícula de la marca
// (solo vacíos, entrar y bookmarklet; nunca detrás de listas densas).
// Uso: <EmptyState title="Aún no hay enlaces" grid icon="bookmark"><p>…</p><Button slot="actions" …/></EmptyState>
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  icon?: IconName;
  grid?: boolean;
  /** Nivel del título (por defecto h2). */
  level?: 'h1' | 'h2' | 'h3';
  class?: string;
}
const { title, icon, grid = false, level: Heading = 'h2', class: className } = Astro.props;
---

<section class:list={['empty', grid && 'grid-bg', className]} data-empty-state>
  {icon && <span class="ico"><Icon name={icon} size={28} /></span>}
  <Heading class="t">{title}</Heading>
  <div class="text"><slot /></div>
  <div class="actions"><slot name="actions" /></div>
</section>

<style>
  .empty {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--s-3);
    padding: var(--s-7) var(--s-5);
    border: 1px dashed var(--mf-paper-grid);
    border-radius: var(--r-lg);
    background-color: var(--surface);
  }
  .empty.grid-bg {
    border-style: solid;
  }
  .ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--r-md);
    background: var(--mf-ink-950);
    color: var(--mf-blue-bright);
  }
  .t {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 24ch;
  }
  .text {
    max-width: 52ch;
    color: var(--text-2);
  }
  .text :global(p) {
    margin: 0 0 var(--s-2);
  }
  .text :global(ol),
  .text :global(ul) {
    text-align: left;
    margin: 0;
    padding-left: 1.2em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
    margin-top: var(--s-2);
  }
  .actions:empty {
    display: none;
  }
</style>
