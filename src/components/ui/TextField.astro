---
// Campo de texto con label, ayuda y error. El valor escrito se conserva (prop `value`).
// Uso: <TextField id="url" name="url" label="URL" type="url" value={url} error={errors.url} hint="Pega una dirección" required />
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  value?: string;
  type?: 'text' | 'url' | 'email' | 'password' | 'search';
  hint?: string;
  error?: string;
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  maxlength?: number;
  inputmode?: 'text' | 'url' | 'email' | 'search' | 'numeric';
  list?: string;
  autofocus?: boolean;
  class?: string;
}
const { id, name, label, value = '', type = 'text', hint, error, required = false, placeholder, autocomplete, maxlength, inputmode, list, autofocus, class: className } = Astro.props;
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---

<div class:list={['field', className]}>
  <label for={id}>{label}{required && <span class="req" aria-hidden="true"> *</span>}</label>
  <input id={id} name={name} type={type} value={value} required={required} placeholder={placeholder} autocomplete={autocomplete} maxlength={maxlength} inputmode={inputmode} list={list} autofocus={autofocus} aria-invalid={error ? 'true' : undefined} aria-describedby={describedby} />
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="error" id={`${id}-error`}><Icon name="alert" size={16} /><span>{error}</span></p>}
</div>

<style>
  p {
    margin: 0;
  }
</style>
