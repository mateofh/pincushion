---
// Área de texto con label, ayuda y error. Conserva el valor.
// Uso: <TextArea id="descripcion" name="descripcion" label="Descripción" value={d} rows={4} />
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  value?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  placeholder?: string;
  maxlength?: number;
  rows?: number;
  class?: string;
}
const { id, name, label, value = '', hint, error, required = false, placeholder, maxlength, rows = 4, class: className } = Astro.props;
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---

<div class:list={['field', className]}>
  <label for={id}>{label}{required && <span class="req" aria-hidden="true"> *</span>}</label>
  <textarea id={id} name={name} rows={rows} required={required} placeholder={placeholder} maxlength={maxlength} aria-invalid={error ? 'true' : undefined} aria-describedby={describedby}>{value}</textarea>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="error" id={`${id}-error`}><Icon name="alert" size={16} /><span>{error}</span></p>}
</div>

<style>
  p {
    margin: 0;
  }
</style>
