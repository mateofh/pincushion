---
// Select nativo con label, ayuda y error. `selected` conserva la elección.
// Uso: <Select id="coleccion" name="coleccion" label="Colección" options={[{ value: '', label: 'Sin colección' }]} selected={actual} />
import Icon from './Icon.astro';

interface Option {
  value: string;
  label: string;
}
interface Props {
  id: string;
  name: string;
  label: string;
  options: Option[];
  selected?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  /** Oculta el label visualmente (sigue disponible para lectores de pantalla). */
  hideLabel?: boolean;
  form?: string;
  class?: string;
}
const { id, name, label, options, selected = '', hint, error, required = false, hideLabel = false, form, class: className } = Astro.props;
const describedby = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---

<div class:list={['field', className]}>
  <label for={id} class:list={[hideLabel && 'visually-hidden']}>{label}{required && <span class="req" aria-hidden="true"> *</span>}</label>
  <select id={id} name={name} required={required} form={form} aria-invalid={error ? 'true' : undefined} aria-describedby={describedby}>
    {options.map((o) => <option value={o.value} selected={o.value === selected}>{o.label}</option>)}
  </select>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="error" id={`${id}-error`}><Icon name="alert" size={16} /><span>{error}</span></p>}
</div>

<style>
  p {
    margin: 0;
  }
</style>
