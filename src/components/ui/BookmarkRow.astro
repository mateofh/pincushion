---
// Enlace en vista de lista (una fila compacta; en móvil se apila). Mismas props que BookmarkCard.
// Uso: <BookmarkRow bookmark={b} csrf={csrf} volver="/?vista=lista" selectable />
import Favicon from './Favicon.astro';
import HighlightedText from './HighlightedText.astro';
import TagChips from './TagChips.astro';
import BookmarkActions from './BookmarkActions.astro';
import BookmarkStatus from './BookmarkStatus.astro';
import SelectBox from './SelectBox.astro';
import { formatDate, isoDate } from './format.ts';
import type { Bookmark } from '../../server/contracts.ts';

interface Props {
  bookmark: Bookmark;
  csrf: string;
  volver: string;
  selectable?: boolean;
  timeZone?: string;
  titleHtml?: string;
  descriptionHtml?: string;
}
const { bookmark: b, csrf, volver, selectable = false, timeZone, titleHtml, descriptionHtml } = Astro.props;
const text = b.description || b.excerpt;
---

<article class:list={['row', !selectable && 'no-sel']} data-bookmark-id={b.id} data-view="lista">
  {selectable && <div class="sel"><SelectBox id={b.id} title={b.title} /></div>}
  <div class="main">
    <h2 class="title">
      <a href={b.url} target="_blank" rel="noopener noreferrer">
        <span class="clamp">{titleHtml ? <HighlightedText html={titleHtml} /> : b.title}</span>
        <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
      </a>
    </h2>
    <p class="meta">
      <Favicon domain={b.domain} hasFavicon={b.hasFavicon} size={16} />
      <span class="mono domain">{b.domain}</span>
      <span class="mono sep" aria-hidden="true">·</span>
      <time class="mono" datetime={isoDate(b.createdAt)}>{formatDate(b.createdAt, timeZone)}</time>
    </p>
    {descriptionHtml ? <p class="text"><HighlightedText html={descriptionHtml} /></p> : text && <p class="text">{text}</p>}
    <TagChips tags={b.tags} collection={b.collection} />
    <BookmarkStatus id={b.id} status={b.fetchStatus} csrf={csrf} volver={volver} />
  </div>
  <div class="acts"><BookmarkActions id={b.id} title={b.title} isFavorite={b.isFavorite} csrf={csrf} volver={volver} /></div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-2) var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .row.no-sel {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .row:has(input:checked) {
    background: #eef5ff;
  }
  .sel {
    padding-top: 2px;
  }
  .main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--s-2);
  }
  .title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .title a {
    color: var(--text);
    text-decoration: none;
    display: block;
    padding: 12px 0;
    margin: -12px 0;
  }
  .clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .title :global(.ext) {
    color: var(--text-muted);
    margin-left: 4px;
    vertical-align: -1px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin: 0;
    color: var(--text-muted);
    min-width: 0;
  }
  .domain {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta time,
  .sep {
    flex: none;
  }
  .text {
    margin: 2px 0 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.4;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .acts {
    padding-top: 2px;
  }
</style>
