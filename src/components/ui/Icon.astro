---
// Icono SVG inline, decorativo (aria-hidden). El significado va siempre en el texto cercano.
// Uso: <Icon name="star" size={18} />
export type IconName =
  | 'star' | 'star-filled' | 'folder' | 'tag' | 'trash' | 'undo' | 'search' | 'plus' | 'check' | 'x' | 'alert'
  | 'refresh' | 'external' | 'grid' | 'list' | 'chevron-down' | 'bookmark' | 'link' | 'menu' | 'copy' | 'minus' | 'info' | 'arrow-right' | 'edit';

interface Props {
  name: IconName;
  /** Lado en px (por defecto 20). */
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const STAR = 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z';
const PATHS: Record<IconName, string[]> = {
  star: [STAR],
  'star-filled': [STAR],
  folder: ['M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'],
  tag: ['M3 12V4h8l9 9-8 8z', 'M7.5 7.5h.01'],
  trash: ['M4 7h16', 'M10 11v6M14 11v6', 'M6 7l1 13h10l1-13', 'M9 7V4h6v3'],
  undo: ['M9 14L4 9l5-5', 'M4 9h10a6 6 0 0 1 0 12h-3'],
  search: ['M11 4a7 7 0 1 0 0 14a7 7 0 0 0 0-14z', 'M20 20l-4-4'],
  plus: ['M12 5v14M5 12h14'],
  check: ['M5 12.5l4.5 4.5L19 7.5'],
  x: ['M6 6l12 12M18 6L6 18'],
  alert: ['M12 3l10 18H2z', 'M12 10v4M12 17.5v.01'],
  refresh: ['M20 11a8 8 0 0 0-14.5-4M4 4v4h4', 'M4 13a8 8 0 0 0 14.5 4M20 20v-4h-4'],
  external: ['M14 4h6v6M20 4l-9 9', 'M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5'],
  grid: ['M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z'],
  list: ['M8 6h12M8 12h12M8 18h12', 'M4 6h.01M4 12h.01M4 18h.01'],
  'chevron-down': ['M6 9l6 6 6-6'],
  bookmark: ['M6 3h12v18l-6-4-6 4z'],
  link: ['M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1', 'M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1'],
  menu: ['M4 6h16M4 12h16M4 18h16'],
  copy: ['M11 9h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z', 'M5 15V5a1 1 0 0 1 1-1h10'],
  minus: ['M5 12h14'],
  info: ['M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0-18z', 'M12 11v5M12 7.5v.01'],
  'arrow-right': ['M5 12h14M13 6l6 6-6 6'],
  edit: ['M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z', 'M13.5 6.5l4 4'],
};
const filled = name === 'star-filled';
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
