---
// Barra de lote de la Biblioteca (variante de ui/BulkBar). Es el <form id="bulk">: las casillas de los enlaces
// se asocian con form="bulk". Añade lo que la Biblioteca necesita:
//   - "Mover a…" con colección existente o una nueva (campo `coleccion_nueva`; `coleccion` vacío = Sin colección),
//   - "Quitar etiqueta" (si hay un filtro de etiqueta) y "Quitar favorito" (si se ve Favoritos).
// Sin JS: barra estática. Con JS: contador y, en móvil, barra fija abajo solo con selección.
import Button from '../ui/Button.astro';
import Select from '../ui/Select.astro';
import type { CollectionRef } from '../../server/contracts.ts';

interface Props {
  csrf: string;
  volver: string;
  collections: CollectionRef[];
  tagSuggestions?: string[];
  showRemoveTag?: boolean;
  showUnfavorite?: boolean;
}
const { csrf, volver, collections, tagSuggestions = [], showRemoveTag = false, showUnfavorite = false } = Astro.props;
const options = [
  { value: '__elegir', label: 'Elige colección…' },
  { value: '', label: 'Sin colección' },
  ...collections.map((c) => ({ value: String(c.id), label: c.name })),
];
---

<form id="bulk" class="bulk" method="post" action="/enlaces/lote" aria-label="Acciones sobre los enlaces seleccionados" data-bulk-bar data-count="0">
  <input type="hidden" name="_csrf" value={csrf} />
  <input type="hidden" name="volver" value={volver} />
  <p class="count" role="status" aria-live="polite" data-bulk-count>
    <span class="static-hint">Marca los enlaces con su casilla y elige una acción.</span>
  </p>
  <div class="tools">
    <div class="grp">
      <label class="visually-hidden" for="bulk-etiqueta">Etiqueta</label>
      <input id="bulk-etiqueta" name="etiqueta" type="text" placeholder="Etiqueta" maxlength="40" autocomplete="off" list={tagSuggestions.length ? 'bulk-etiquetas' : undefined} />
      {tagSuggestions.length > 0 && <datalist id="bulk-etiquetas">{tagSuggestions.map((t) => <option value={t} />)}</datalist>}
      <Button variant="ghost" size="sm" type="submit" name="accion" value="etiquetar" icon="tag">Añadir etiqueta</Button>
      {showRemoveTag && <Button variant="ghost" size="sm" type="submit" name="accion" value="quitar-etiqueta">Quitar etiqueta</Button>}
    </div>
    <div class="grp">
      <Select id="bulk-coleccion" name="coleccion" label="Colección de destino" options={options} selected="__elegir" hideLabel />
      <label class="visually-hidden" for="bulk-coleccion-nueva">Nombre de una colección nueva</label>
      <input id="bulk-coleccion-nueva" name="coleccion_nueva" type="text" placeholder="o una nueva" maxlength="80" autocomplete="off" />
      <Button variant="ghost" size="sm" type="submit" name="accion" value="mover" icon="folder">Mover a…</Button>
    </div>
    <div class="grp">
      <Button variant="ghost" size="sm" type="submit" name="accion" value="favorito" icon="star">Favorito</Button>
      {showUnfavorite && <Button variant="ghost" size="sm" type="submit" name="accion" value="quitar-favorito">Quitar favorito</Button>}
      <Button variant="ghost" size="sm" type="submit" name="accion" value="papelera" icon="trash" class="trash">Mover a la papelera</Button>
    </div>
  </div>
</form>

<style>
  .bulk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding: var(--s-2) var(--s-4);
    margin-bottom: var(--s-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .count {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-2);
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-left: auto;
  }
  .grp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
  }
  .grp input {
    width: 130px;
    min-height: 36px;
    padding: 0 12px;
    font: 400 14px var(--mf-text);
    color: var(--text);
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--r-pill);
  }
  .grp :global(.field select) {
    min-height: 36px;
    padding: 0 36px 0 12px;
    width: auto;
    max-width: 170px;
    font-size: 14px;
    border-radius: var(--r-pill);
    background-position: right 10px center;
  }
  .bulk :global(.trash) {
    color: var(--mf-warn-text);
    border-color: var(--mf-warn-text);
  }
  .bulk :global(.trash:hover) {
    background: var(--mf-warn-text);
    color: #fff;
  }
  @media (pointer: coarse), (max-width: 720px) {
    .grp input,
    .grp :global(.field select) {
      min-height: var(--tap);
    }
    .bulk :global(.btn-sm) {
      min-height: var(--tap);
    }
  }

  /* Mejorada con JS: contador y, en móvil, barra fija solo con selección. */
  .bulk[data-enhanced] .static-hint {
    display: none;
  }
  @media (max-width: 720px) {
    .bulk[data-enhanced] {
      position: fixed;
      left: var(--s-3);
      right: var(--s-3);
      /* por encima del botón "Guardar enlace" del layout (52 px + 16 px + aire) */
      bottom: calc(var(--s-4) + 52px + var(--s-3) + env(safe-area-inset-bottom));
      z-index: 15;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      box-shadow: var(--shadow-deep);
      max-height: 60vh;
      overflow-y: auto;
    }
    .bulk[data-enhanced][data-count='0'] {
      display: none;
    }
    .tools {
      margin-left: 0;
      flex-direction: column;
      align-items: stretch;
    }
    .grp {
      width: 100%;
    }
    .grp input {
      flex: 1 1 8ch;
      min-width: 0;
      width: auto;
    }
    .grp :global(.field) {
      flex: 1 1 10ch;
      min-width: 0;
    }
    .grp :global(.field select) {
      max-width: none;
      width: 100%;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLFormElement>('[data-bulk-bar]');
  const out = bar?.querySelector<HTMLElement>('[data-bulk-count]');
  if (bar && out) {
    bar.dataset.enhanced = 'true';
    const boxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('input[type="checkbox"][form="bulk"]'));
    const update = () => {
      const n = boxes().filter((b) => b.checked).length;
      bar.dataset.count = String(n);
      out.textContent = n === 0 ? 'Ningún enlace seleccionado' : n === 1 ? '1 seleccionado' : `${n} seleccionados`;
    };
    document.addEventListener('change', (e) => {
      const t = e.target;
      if (t instanceof HTMLInputElement && t.type === 'checkbox' && t.getAttribute('form') === 'bulk') update();
    });
    update();
  }
</script>
