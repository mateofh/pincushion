---
// Variante de SortSelect que conserva filtros repetibles (varias etiquetas): `fields` es una lista de pares.
// Formulario GET con botón "Aplicar" visible sin JS; con JS se envía al cambiar la selección.
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';

interface Props {
  action?: string;
  value?: 'recientes' | 'antiguos' | 'titulo' | 'dominio';
  fields?: [string, string][];
}
const { action = '/', value = 'recientes', fields = [] } = Astro.props;
const options = [
  { value: 'recientes', label: 'Más recientes' },
  { value: 'antiguos', label: 'Más antiguos' },
  { value: 'titulo', label: 'Título (A–Z)' },
  { value: 'dominio', label: 'Dominio (A–Z)' },
];
---

<form class="sort" method="get" action={action} data-lib-sort>
  {fields.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  <Select id="orden" name="orden" label="Ordenar" options={options} selected={value} />
  <Button variant="secondary" size="sm" type="submit" class="apply" data-lib-sort-apply>Aplicar</Button>
</form>

<style>
  .sort {
    display: flex;
    align-items: flex-end;
    gap: var(--s-2);
  }
  .sort :global(.field) {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .sort :global(.field label) {
    font-size: 14px;
    color: var(--text-2);
  }
  .sort :global(.field select) {
    width: auto;
    min-width: 11ch;
    border-radius: var(--r-pill);
    padding-left: var(--s-4);
  }
  .sort :global([data-lib-sort-apply]) {
    min-height: var(--tap);
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lib-sort]').forEach((form) => {
    const select = form.querySelector('select');
    const apply = form.querySelector<HTMLElement>('[data-lib-sort-apply]');
    if (!select) return;
    if (apply) apply.hidden = true;
    select.addEventListener('change', () => form.requestSubmit());
  });
</script>
