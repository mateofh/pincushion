---
// Resultado mínimo del popup del bookmarklet cuando no hay sesión o es una respuesta de solo token:
// solo dice qué pasó; nunca revela datos de la biblioteca.
import Icon from '../ui/Icon.astro';
interface Props {
  kind: 'success' | 'warn' | 'error';
  title: string;
  /** Texto de apoyo (ya en español). */
  message?: string;
  links?: { href: string; label: string }[];
}
const { kind, title, message, links = [] } = Astro.props;
---
<section class={`result result-${kind}`} aria-labelledby="popup-t" role={kind === 'success' ? undefined : 'alert'}>
  <span class="ico"><Icon name={kind === 'success' ? 'check' : 'alert'} size={28} /></span>
  <h1 id="popup-t">{title}</h1>
  {message && <p>{message}</p>}
  <slot />
  {links.length > 0 && <p class="links">{links.map((l) => <a class="btn btn-ghost" href={l.href}>{l.label}</a>)}</p>}
</section>
<style>
  .result {
    max-width: 460px;
    margin: var(--s-6) auto;
    padding: var(--s-6);
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-soft);
  }
  .result-success {
    border-top-color: var(--mf-success-text);
  }
  .result-success .ico {
    color: var(--mf-success-text);
  }
  .result-warn,
  .result-error {
    border-top-color: var(--mf-warn-text);
  }
  .result-warn .ico,
  .result-error .ico {
    color: var(--mf-warn-text);
  }
  h1 {
    font-size: 30px;
  }
  p {
    margin: 0;
    color: var(--text-2);
  }
  .links {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
</style>
