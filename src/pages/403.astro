---
// 403: CSRF inválido u origen no permitido. Mensaje humano y salida; nada se modificó.
import ErrorPage from '../components/ErrorPage.astro';
const signedIn = Boolean(Astro.locals.user);
---

<ErrorPage
  status={403}
  title="Este formulario caducó"
  message="Por seguridad no pudimos aplicar el cambio. Recarga la página e inténtalo otra vez; tus datos no se modificaron."
  actionHref={signedIn ? '/' : '/entrar'}
  actionLabel={signedIn ? 'Ir a la Biblioteca' : 'Ir a Entrar'}
/>
