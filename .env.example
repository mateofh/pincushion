# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
# db:migrate, db:seed y user:create leen ./.env solos. `npm start`, `npm run dev` y
# `npm run jobs:once` NO lo leen todavía: exporta antes las variables con
# `set -a; . ./.env; set +a` o arranca con `node --env-file=.env ...`.
# db:backup y db:restore solo usan DATABASE_PATH del entorno.

# Origen público de la app (esquema + host + puerto; debe coincidir con la URL del navegador). Si es https se activan cookies
# Secure con prefijo __Host- y la cabecera HSTS. Se usa también para validar Origin (CSRF).
APP_ORIGIN=http://localhost:4321

# Secreto maestro (mínimo 32 caracteres). De él se derivan las claves del token del
# bookmarklet. Genera uno con: openssl rand -hex 32. Cambiarlo invalida los tokens del bookmarklet.
APP_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# Ruta del archivo SQLite. Su carpeta debe ser un volumen persistente en producción.
# Las copias previas a migrar se guardan en <carpeta>/backups/.
DATABASE_PATH=./data/pincushion.db

# Puerto en el que escucha el servidor Node.
PORT=4321

# Interfaz en la que escucha. 127.0.0.1 si hay un proxy delante; 0.0.0.0 en contenedores.
HOST=127.0.0.1

# 1 si la app está detrás de un proxy inverso de confianza: la IP del cliente (para los límites
# de login) se toma de X-Forwarded-For. 0 usa la IP del socket. Valores válidos: 0, 1, true, false.
TRUST_PROXY=0

# Nivel de log JSON: debug, info, warn, error o silent.
LOG_LEVEL=info

# 1 para ejecutar el worker de metadatos dentro del proceso web; 0 si lo lanzas aparte
# (npm run jobs:once).
JOBS_INLINE_WORKER=1

# Tiempo máximo en ms para obtener los datos de una página (500 a 30000).
METADATA_TIMEOUT_MS=8000

# Bytes máximos que se descargan de una página (10000 a 10000000).
METADATA_MAX_BYTES=1500000

# Caracteres máximos del texto guardado para la búsqueda (200 a 8000).
EXCERPT_MAX_CHARS=8000

# Intentos de login por minuto y por IP antes de responder 429 (1 a 10000).
RATE_LIMIT_LOGIN_PER_MIN=5

# Solo para pruebas automáticas: 1 permite que el fetcher visite los hosts de
# METADATA_TEST_HOSTS. No lo actives en producción.
PINCUSHION_TEST_MODE=0

# Solo con PINCUSHION_TEST_MODE=1: host:puerto locales permitidos, separados por coma
# (por ejemplo localhost:4411). Déjalo vacío en producción.
METADATA_TEST_HOSTS=
