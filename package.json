{
  "name": "pincushion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --disable-warning=ExperimentalWarning server/entry.mjs",
    "check": "astro check",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "user:create": "node --disable-warning=ExperimentalWarning scripts/user-create.ts",
    "jobs:once": "node --disable-warning=ExperimentalWarning scripts/jobs-once.ts",
    "test:unit": "vitest run",
    "test:e2e": "astro build && playwright test --trace off",
    "test": "npm run check && npm run test:unit && npm run test:e2e",
    "test:ux": "astro build && playwright test --trace off --grep @nocturno"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.12",
    "htmlparser2": "^12.0.0",
    "htmx.org": "^2.0.11",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
